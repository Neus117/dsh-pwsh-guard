{
  "_comment": "dsh-pwsh-guard rules. Loaded by pwsh-guard.exe from the directory next to the executable. Editing this file is enough; no rebuild needed. Destructive verbs are anchored at statement position on purpose (start, or after ; | && { newline) so that merely quoting the word - e.g. grepping a file for it - is not blocked.",
  "version": 3,

  "logPath": "logs\\guard.jsonl",
  "maxLogBytes": 5242880,
  "maxLoggedCommandChars": 4000,

  "allowMarker": "dsh-guard:allow-destructive",

  "protectedRoots": [
    "$home",
    "$env:USERPROFILE",
    "$env:APPDATA",
    "$env:LOCALAPPDATA",
    "$env:ProgramData",
    "%USERPROFILE%",
    "%APPDATA%",
    "%LOCALAPPDATA%"
  ],

  "pwshCandidates": [
    "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
    "C:\\Program Files\\PowerShell\\7-preview\\pwsh.exe",
    "C:\\Users\\Neus117\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShell_8wekyb3d8bbwe\\pwsh.exe",
    "C:\\Users\\Neus117\\AppData\\Local\\Microsoft\\WindowsApps\\pwsh.exe"
  ],

  "rules": [
    {
      "id": "delete-cmdlet",
      "enabled": true,
      "pattern": "(?:^|[;\\r\\n|&{]\\s*)(?:Remove-Item|Remove-ItemProperty|Clear-Content|Clear-RecycleBin)\\b",
      "reason": "deletes files, keys, content or the recycle bin"
    },
    {
      "id": "delete-alias",
      "enabled": true,
      "pattern": "(?:^|[;\\r\\n|&{]\\s*)(?:del|erase|rd|rmdir|rm|ri)(?:\\s|$)",
      "reason": "cmdlet alias that deletes"
    },
    {
      "id": "move-cmdlet",
      "enabled": true,
      "pattern": "(?:^|[;\\r\\n|&{]\\s*)(?:Move-Item|mv)(?:\\s|$)",
      "reason": "moves/overwrites paths"
    },
    {
      "id": "git-clean",
      "enabled": true,
      "pattern": "(?:^|[;\\r\\n|&{]\\s*)git\\s+clean\\b",
      "reason": "deletes untracked files"
    },
    {
      "id": "robocopy-mirror",
      "enabled": true,
      "pattern": "\\brobocopy\\b[\\s\\S]*?/(?:MIR|MOV|PURGE)\\b",
      "reason": "mirror/purge deletes destination content"
    },
    {
      "id": "taskkill-tree",
      "enabled": true,
      "pattern": "\\btaskkill\\b[\\s\\S]*?/T\\b",
      "reason": "kills a whole process tree"
    },
    {
      "id": "script-bypass",
      "enabled": true,
      "pattern": "\\b(?:powershell|pwsh)(?:\\.exe)?\\b[\\s\\S]*?\\s-(?:file|encodedcommand|enc)\\b",
      "reason": "hides the real command inside a script file or encoded payload"
    }
  ]
}
